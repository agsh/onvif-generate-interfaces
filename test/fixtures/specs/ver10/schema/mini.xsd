<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal schema fixture for snapshot tests.
  Covers: enums, lists, restriction aliases, complexContent extension,
  ProfileToken field, xs:any ##any, Object rename, PositiveInteger / Duration.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tt="http://www.onvif.org/ver10/schema"
           targetNamespace="http://www.onvif.org/ver10/schema"
           elementFormDefault="qualified" version="0.0.1">

  <xs:simpleType name="ReferenceToken">
    <xs:annotation>
      <xs:documentation>Opaque reference token.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="MoveStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="IDLE"/>
      <xs:enumeration value="MOVING"/>
      <xs:enumeration value="UNKNOWN"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ReferenceTokenList">
    <xs:list itemType="tt:ReferenceToken"/>
  </xs:simpleType>

  <xs:simpleType name="Delay">
    <xs:restriction base="xs:duration"/>
  </xs:simpleType>

  <xs:complexType name="DeviceEntity">
    <xs:attribute name="token" type="tt:ReferenceToken" use="required"/>
  </xs:complexType>

  <xs:complexType name="Object">
    <xs:annotation>
      <xs:documentation>Analytics object (renamed to OnvifObject in TS).</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="tt:DeviceEntity">
        <xs:sequence>
          <xs:element name="Appearance" type="xs:string" minOccurs="0"/>
          <xs:any namespace="##any" processContents="lax" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="PTZStatus">
    <xs:sequence>
      <xs:element name="MoveStatus" type="tt:MoveStatus" minOccurs="0"/>
      <xs:element name="UtcTime" type="xs:dateTime"/>
      <xs:any namespace="##any" processContents="lax" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="GetStatus">
    <xs:sequence>
      <xs:element name="ProfileToken" type="tt:ReferenceToken"/>
      <xs:element name="Count" type="xs:positiveInteger" minOccurs="0"/>
      <!-- Reference to analytics Object — must resolve to OnvifObject, not unknown -->
      <xs:element name="Tracked" type="tt:Object" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Top-level xs:choice (cf. SerialData / VideoAnalyticsStream) -->
  <xs:complexType name="SerialData">
    <xs:choice>
      <xs:element name="Binary" type="xs:base64Binary"/>
      <xs:element name="String" type="xs:string"/>
    </xs:choice>
  </xs:complexType>

  <!-- Choice inside sequence + unbounded (cf. MetadataStream) -->
  <xs:complexType name="MetadataStream">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="PTZ" type="tt:PTZStatus"/>
        <xs:element name="Event" type="xs:string"/>
        <xs:any namespace="##any" processContents="lax" minOccurs="0"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <!-- Exclusive choice of named alternatives (cf. PTZPresetTourPresetDetail) -->
  <xs:complexType name="PresetDetail">
    <xs:sequence>
      <xs:choice>
        <xs:element name="PresetToken" type="tt:ReferenceToken"/>
        <xs:element name="Home" type="xs:boolean"/>
      </xs:choice>
      <xs:any namespace="##any" processContents="lax" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- xs:union (cf. Direction → ExtendedDirection) -->
  <xs:simpleType name="ExtendedDirection">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Left"/>
      <xs:enumeration value="Right"/>
      <xs:enumeration value="Any"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Direction">
    <xs:union memberTypes="tt:ExtendedDirection"/>
  </xs:simpleType>

  <!-- xs:simpleContent: text node + attributes (cf. CertificateUsage) -->
  <xs:complexType name="CertificateUsage">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="Critical" type="xs:boolean" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- xs:simpleContent without named attrs → alias to base (cf. OSDReference) -->
  <xs:complexType name="TokenRef">
    <xs:simpleContent>
      <xs:extension base="tt:ReferenceToken">
        <xs:anyAttribute processContents="lax"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- xs:all — unordered elements -->
  <xs:complexType name="UnorderedPair">
    <xs:all>
      <xs:element name="Left" type="xs:string"/>
      <xs:element name="Right" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- Named group + attributeGroup, referenced from a complexType -->
  <xs:attributeGroup name="TokenAttrs">
    <xs:attribute name="token" type="tt:ReferenceToken" use="required"/>
    <xs:attribute name="Name" type="xs:string"/>
  </xs:attributeGroup>
  <xs:group name="PointPair">
    <xs:sequence>
      <xs:element name="X" type="xs:float"/>
      <xs:element name="Y" type="xs:float"/>
    </xs:sequence>
  </xs:group>
  <xs:complexType name="NamedPoint">
    <xs:sequence>
      <xs:group ref="tt:PointPair"/>
    </xs:sequence>
    <xs:attributeGroup ref="tt:TokenAttrs"/>
  </xs:complexType>

  <!-- ##other / ##targetNamespace open content (cf. FrameExtension / FrameExtension2) -->
  <xs:complexType name="FrameExtension">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="MotionInCells" type="xs:boolean" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="FrameExtension2">
    <xs:sequence>
      <xs:any namespace="##targetNamespace" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
